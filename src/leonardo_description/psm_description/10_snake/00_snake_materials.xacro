        <color rgba="0.592 0.974 0.315 ${alpha}"/>
    </material>
    <material name="s1_color_10">
        <color rgba="0.529 0.896 0.410 ${alpha}"/>
    </material>
    <material name="s1_color_11">
        <color rgba="0.470 0.770 0.516 ${alpha}"/>
    </material>
    <material name="s1_color_12">
        <color rgba="0.420 0.608 0.628 ${alpha}"/>
    </material>

    <!-- ================================================== -->
    <!-- S2 色系：青 → 蓝 → 紫（色相 180° → 240°）饱和 1  -->
    <!-- ================================================== -->
    <material name="s2_color_0">
        <color rgba="0.150 0.700 0.700 ${alpha}"/>
    </material>
    <material name="s2_color_1">
        <color rgba="0.123 0.633 0.760 ${alpha}"/>
    </material>
    <material name="s2_color_2">
        <color rgba="0.121 0.544 0.816 ${alpha}"/>
    </material>
    <material name="s2_color_3">
        <color rgba="0.144 0.446 0.861 ${alpha}"/>
    </material>
    <material name="s2_color_4">
        <color rgba="0.190 0.349 0.887 ${alpha}"/>
    </material>
    <material name="s2_color_5">
        <color rgba="0.256 0.261 0.888 ${alpha}"/>
    </material>
    <material name="s2_color_6">
        <color rgba="0.338 0.189 0.859 ${alpha}"/>
    </material>
    <material name="s2_color_7">
        <color rgba="0.429 0.136 0.803 ${alpha}"/>
    </material>
    <material name="s2_color_8">
        <color rgba="0.524 0.101 0.723 ${alpha}"/>
    </material>
    <material name="s2_color_9">
        <color rgba="0.615 0.083 0.628 ${alpha}"/>
    </material>
    <material name="s2_color_9b">
        <color rgba="0.694 0.081 0.526 ${alpha}"/>
    </material>
    <material name="s2_color_10">
        <color rgba="0.754 0.096 0.423 ${alpha}"/>
