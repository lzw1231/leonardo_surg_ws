        <color rgba="0.148 0.651 0.655 ${alpha}"/>
    </material>
    <material name="s3_color_6">
        <color rgba="0.196 0.604 0.758 ${alpha}"/>
    </material>
    <material name="s3_color_7">
        <color rgba="0.259 0.550 0.846 ${alpha}"/>
