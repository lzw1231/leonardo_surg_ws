        <color rgba="0.333 0.491 0.912 ${alpha}"/>
    </material>
    <material name="s3_color_9">
        <color rgba="0.416 0.430 0.946 ${alpha}"/>
    </material>
    <material name="s3_color_9b">
        <color rgba="0.503 0.369 0.940 ${alpha}"/>
    </material>
    <material name="s3_color_10">
        <color rgba="0.588 0.313 0.893 ${alpha}"/>
    </material>
    <material name="s3_color_11">
        <color rgba="0.662 0.264 0.810 ${alpha}"/>
    </material>
    <material name="s3_color_12">
        <color rgba="0.720 0.226 0.703 ${alpha}"/>
    </material>


</robot>