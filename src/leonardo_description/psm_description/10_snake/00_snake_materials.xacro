<?xml version="1.0" encoding="UTF-8"?>
<!-- 全局材质库  -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="alpha" value="1"/>

    <!-- ================================================== -->
    <!-- S1 色系：红 → 橙 → 黄（色相 0° → 60°）饱和 1  -->
    <!-- ================================================== -->
    <material name="s1_color_0">
        <color rgba="0.850 0.150 0.150 ${alpha}"/>
    </material>
    <material name="s1_color_1">
        <color rgba="0.869 0.262 0.100 ${alpha}"/>
    </material>
    <material name="s1_color_2">
        <color rgba="0.878 0.373 0.063 ${alpha}"/>
    </material>
    <material name="s1_color_3">
        <color rgba="0.876 0.483 0.040 ${alpha}"/>
    </material>
    <material name="s1_color_4">
        <color rgba="0.863 0.591 0.032 ${alpha}"/>
    </material>
    <material name="s1_color_5">
        <color rgba="0.840 0.696 0.040 ${alpha}"/>
    </material>
    <material name="s1_color_6">
        <color rgba="0.807 0.796 0.064 ${alpha}"/>
    </material>
    <material name="s1_color_7">
        <color rgba="0.765 0.887 0.104 ${alpha}"/>
    </material>
    <material name="s1_color_8">
        <color rgba="0.714 0.958 0.160 ${alpha}"/>
    </material>
    <material name="s1_color_9">
        <color rgba="0.655 0.994 0.231 ${alpha}"/>
