    <material name="s2_color_11">
        <color rgba="0.792 0.126 0.326 ${alpha}"/>
    </material>
    <material name="s2_color_12">
        <color rgba="0.806 0.170 0.241 ${alpha}"/>
    </material>

    <!-- ================================================== -->
    <!-- S3 色系：绿 → 青（色相 120° → 180°）饱和 1  -->
    <!-- ================================================== -->
    <material name="s3_color_0">
        <color rgba="0.150 0.700 0.150 ${alpha}"/>
    </material>
    <material name="s3_color_1">
        <color rgba="0.117 0.722 0.236 ${alpha}"/>
    </material>
    <material name="s3_color_2">
        <color rgba="0.100 0.726 0.333 ${alpha}"/>
    </material>
    <material name="s3_color_3">
        <color rgba="0.099 0.714 0.438 ${alpha}"/>
    </material>
    <material name="s3_color_4">
        <color rgba="0.115 0.688 0.547 ${alpha}"/>
    </material>
