                <origin xyz="0 0 0" rpy="${pi} 0 0" />
                <material name="${prefix}_link02" />
            </visual>
            <collision>
                <geometry>
                    <mesh filename="${stl_path}/02.stl" scale="${mesh_scale}" />
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0" />
            </collision>
            <xacro:snake_cylinder_inertia m="${link02_m}" r="${link02_r}" l="${link02_l}" o_xyz="0 0 0"
                o_rpy="0 0 0" />
