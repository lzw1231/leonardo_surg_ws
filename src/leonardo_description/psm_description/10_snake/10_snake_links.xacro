<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="get_snake_links" params="prefix">

        <!-- ==================== 4个虚拟link，用来生成4个虚拟旋转joint ==================== -->
        <link name="${prefix}_link_for_motor_01" />
        <link name="${prefix}_link_for_motor_02" />
        <link name="${prefix}_link_for_motor_03" />
        <link name="${prefix}_link_for_motor_04" />

        <!-- ==================== Link 01 ==================== -->
        <link name="${prefix}_01">
            <visual>
                <geometry>
                    <mesh filename="${stl_path}/01.stl" scale="${mesh_scale}" />
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <material name="${prefix}_link01" />
            </visual>
            <collision>
                <geometry>
                    <mesh filename="${stl_path}/01.stl" scale="${mesh_scale}" />
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0" />
            </collision>
            <xacro:snake_cylinder_inertia m="${link01_m}" r="${link01_r}" l="${link01_l}" o_xyz="0 0 0"
                o_rpy="0 0 0" />
        </link>

        <!-- ==================== Link 02 ==================== -->
        <link name="${prefix}_02">
            <visual>
                <geometry>
                    <mesh filename="${stl_path}/02.stl" scale="${mesh_scale}" />
