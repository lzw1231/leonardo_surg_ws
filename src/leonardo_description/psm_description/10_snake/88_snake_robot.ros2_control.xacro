<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ==================== 宏定义 ==================== -->

    <!-- 最基础的关节声明：只有 position 指令/状态 -->
    <xacro:macro name="can_joint" params="name">
        <joint name="${name}">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>
    </xacro:macro>

    <!-- 单个从臂：6 个虚拟电机 + 11 个转动关节 -->
    <xacro:macro name="arm" params="prefix">
        <!-- 虚拟电机 -->
        <xacro:can_joint name="${prefix}_joint_motor_01" />
        <xacro:can_joint name="${prefix}_joint_motor_02" />
        <xacro:can_joint name="${prefix}_joint_motor_03" />
        <xacro:can_joint name="${prefix}_joint_motor_04" />
        <xacro:can_joint name="${prefix}_joint_motor_05" />
        <xacro:can_joint name="${prefix}_joint_motor_06" />

        <!-- 转动关节 -->
        <xacro:can_joint name="${prefix}_j01_base" />
        <xacro:can_joint name="${prefix}_j03_oc" />
        <xacro:can_joint name="${prefix}_j04_oc" />
        <xacro:can_joint name="${prefix}_j07_oc" />
        <xacro:can_joint name="${prefix}_j08_oc" />
        <xacro:can_joint name="${prefix}_j11_oc" />
        <xacro:can_joint name="${prefix}_j12_oc" />
        <xacro:can_joint name="${prefix}_j13_oc" />
        <xacro:can_joint name="${prefix}_j14_oc" />
        <xacro:can_joint name="${prefix}_j17_18" />
        <xacro:can_joint name="${prefix}_j20_21" />
    </xacro:macro>

    <!-- ==================== 实例化 ==================== -->

    <ros2_control name="psm_ros2_control" type="system">

        <hardware>
            <plugin>psm_hardware_interface/AloeHardwareInterface</plugin>

            <!-- CAN 通道 -->
            <param name="can0_interface">can0</param>
            <param name="can1_interface">can1</param>

            <!-- 从臂 ID（V6 协议：从臂1=0x441，从臂2=0x442，从臂3=0x443） -->
            <param name="slave_1_id">0x441</param>
            <param name="slave_2_id">0x442</param>
            <param name="slave_3_id">0x443</param>

            <!-- A3 电流/速度默认值（max_current 单位 0.01A，100→1.00A；speed_level 1/2/3=30%/60%/100%） -->
            <param name="max_current">100</param>
            <param name="speed_level">3</param>
        </hardware>

        <!-- 三个从臂结构完全一致，各一行实例化 -->
        <xacro:arm prefix="s1" />
        <xacro:arm prefix="s2" />
        <xacro:arm prefix="s3" />

    </ros2_control>

</robot>