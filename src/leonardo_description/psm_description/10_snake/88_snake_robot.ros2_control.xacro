<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <ros2_control name="IntelligentCan0Ros2Control" type="system">

        <hardware>
            <plugin>psm_hardware_interface/IntelligentCan0HardwareInterface</plugin>
            <!-- CAN 通道 -->
            <param name="can_interface">can0</param>

            <!-- 本通道挂载的从臂 ID（V6 协议：从臂1=0x441，从臂2=0x442） -->
            <param name="slave_1_id">0x441</param>
            <param name="slave_2_id">0x442</param>

            <!-- A3 电流/速度默认值（可不下发，只做初始化用） -->
            <param name="max_current">100</param>   <!-- 0.01 A 单位，100 → 1.00 A -->
            <param name="speed_level">3</param>     <!-- 1/2/3 对应 30%/60%/100% -->
        </hardware>


        <!-- ****************** 1号从臂的电机 ****************** -->
        <joint name="s1_joint_motor_01">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s1_joint_motor_02">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s1_joint_motor_03">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s1_joint_motor_04">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <!-- ****************** 1号从臂的转动关节 ****************** -->
        <joint name="s1_j01_base">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s1_j03_oc">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s1_j04_oc">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s1_j07_oc">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s1_j08_oc">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s1_j11_oc">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s1_j12_oc">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s1_j13_oc">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s1_j14_oc">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s1_j17_18">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s1_j20_21">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <!-- ****************** 1号从臂的电机 ****************** -->
        <joint name="s2_joint_motor_01">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s2_joint_motor_02">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s2_joint_motor_03">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s2_joint_motor_04">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <!-- ****************** 2号从臂的转动关节 ****************** -->
        <joint name="s2_j01_base">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s2_j03_oc">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s2_j04_oc">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s2_j07_oc">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s2_j08_oc">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s2_j11_oc">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s2_j12_oc">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s2_j13_oc">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s2_j14_oc">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s2_j17_18">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s2_j20_21">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

    </ros2_control>

    <ros2_control name="IntelligentCan1Ros2Control" type="system">

        <hardware>
            <plugin>psm_hardware_interface/IntelligentCan1HardwareInterface</plugin>
            <!-- CAN 通道 -->
            <param name="can_interface">can1</param>

            <!-- 本通道挂载的从臂 ID（V6 协议：从臂3=0x443） -->
            <param name="slave_3_id">0x443</param>

            <!-- A3 电流/速度默认值（可不下发，只做初始化用） -->
            <param name="max_current">100</param>   <!-- 0.01 A 单位，100 → 1.00 A -->
            <param name="speed_level">3</param>     <!-- 1/2/3 对应 30%/60%/100% -->
        </hardware>

        <!-- ****************** 3号从臂的电机 ****************** -->
        <joint name="s3_joint_motor_01">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s3_joint_motor_02">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s3_joint_motor_03">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s3_joint_motor_04">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <!-- ****************** 3号从臂的转动关节 ****************** -->

        <joint name="s3_j01_base">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s3_j03_oc">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s3_j04_oc">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s3_j07_oc">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s3_j08_oc">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s3_j11_oc">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s3_j12_oc">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s3_j13_oc">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s3_j14_oc">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s3_j17_18">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

        <joint name="s3_j20_21">
            <command_interface name="position" />
            <state_interface name="position" />
        </joint>

    </ros2_control>

</robot>