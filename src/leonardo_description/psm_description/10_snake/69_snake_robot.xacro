<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!--  00 加载 inertia 宏定义-->
    <xacro:include filename="00_snake_inertia.xacro" />

    <!-- 00 加载snake材质 -->
    <xacro:include filename="00_snake_materials.xacro" />

    <!-- 11 stl模型缩1000倍，单位转为 米 -->
    <xacro:property name="mesh_scale" value="0.001 0.001 0.001" />

    <!-- 12 stl模型路径 -->
    <xacro:property name="stl_path" value="package://leonardo_description/psm_description/00_meshes/stl_02" />

    <!-- 13 各连杆的质量、外径、长度 -->
    <xacro:include filename="00_snake_params.xacro" />

    <!-- 14 创建连杆的函数 -->
    <xacro:include filename="10_snake_links.xacro" />

    <!-- 15 创建关节的函数 -->
    <xacro:include filename="11_snake_joints.xacro" />

    <!-- 16 调用宏生成3条snake和jonints -->
    <xacro:get_snake_links prefix="s1" />
    <xacro:get_snake_links prefix="s2" />
    <xacro:get_snake_links prefix="s3" />

    <xacro:get_snake_joints prefix="s1" />
    <xacro:get_snake_joints prefix="s2" />
    <xacro:get_snake_joints prefix="s3" />


    <!-- 17 生成 base_footprint_snake 固定基座 -->
    <link name="base_footprint_snake" />

    <joint name="s1_j01_base" type="prismatic">
        <parent link="base_footprint_snake" />
        <child link="s1_01" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="10.0" velocity="0.5" lower="-0.1" upper="0.1" />
    </joint>

    <joint name="s2_j01_base" type="prismatic">
        <parent link="base_footprint_snake" />
        <child link="s2_01" />
        <origin xyz="0.05 0 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="10.0" velocity="0.5" lower="-0.1" upper="0.1" />
    </joint>

    <joint name="s3_j01_base" type="prismatic">
        <parent link="base_footprint_snake" />
        <child link="s3_01" />
        <origin xyz="0.1 0 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="10.0" velocity="0.5" lower="-0.1" upper="0.1" />
    </joint>

</robot>