<?xml version="1.0" encoding="UTF-8"?>
<!-- 蛇形机械臂关节定义：适配 22 个 link，统一关节命名 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ==========  X 轴偏移量  ========== -->
    <xacro:property name="y_offset_01_02" value="0.051" />
    <xacro:property name="y_offset_02_03" value="0.001" />
    <xacro:property name="y_offset_03_04" value="0.004" />
    <xacro:property name="y_offset_04_05" value="0.004" />
    <xacro:property name="y_offset_05_06" value="0.0084" />
    <xacro:property name="y_offset_06_07" value="0.0084" />
    <xacro:property name="y_offset_07_08" value="0.004" />
    <xacro:property name="y_offset_08_09" value="0.004" />
    <xacro:property name="y_offset_09_10" value="0.0055" />
    <xacro:property name="y_offset_10_11" value="0.0" />
    <xacro:property name="y_offset_11_12" value="0.004" />
    <xacro:property name="y_offset_12_13" value="0.004" />
    <xacro:property name="y_offset_13_14" value="0.004" />
    <xacro:property name="y_offset_14_15" value="0.004" />
    <xacro:property name="y_offset_15_16" value="0.0015" />
    <xacro:property name="y_offset_16_17" value="0.01172" />
    <xacro:property name="y_offset_17_18" value="0.00728" />
    <xacro:property name="y_offset_18_19" value="-0.0013" />
    <xacro:property name="y_offset_19_20" value="0.005" />
    <xacro:property name="y_offset_20_21" value="0.0" />
    <xacro:property name="y_offset_20_22" value="0.0" />

    <!-- 公转半径：两齿轮中心距（两齿轮半径之和） -->
    <xacro:property name="orbit_r" value="0.0025" />

    <!-- 公转角度限位（±45°） -->
    <xacro:property name="orbit_lower" value="${-pi/8.0}" />
    <xacro:property name="orbit_upper" value="${pi/8.0}" />

    <!-- 原点相对齿轮中心的偏移 -->
    <xacro:property name="origin_gear_center" value="0.00145" />

    <!-- ========= 最大力矩 ======== -->
    <xacro:property name="effort" value="1000" />

    <!-- ========= 最大速度 rad/s ======== -->
    <xacro:property name="velocity" value="${4.0 * pi}" />

    <!-- ========== 宏定义：生成所有关节 ========== -->
    <xacro:macro name="get_snake_joints" params="prefix">

        <!-- **************************  link01 -> link02  ************************** -->
        <joint name="${prefix}_joint_01_02" type="fixed">
            <parent link="${prefix}_01" />
            <child link="${prefix}_02" />
            <origin xyz="0 ${y_offset_01_02} 0" rpy="0 0 0" />
        </joint>

        <!-- **************************  link02 -> link03  ************************** -->
        <joint name="${prefix}_joint_02_03" type="fixed">
            <parent link="${prefix}_02" />
            <child link="${prefix}_03" />
            <origin xyz="0 ${y_offset_02_03} 0" rpy="0 0 0" />
        </joint>

        <!-- **************************  link03 -> link04  ************************** -->
        <link name="${prefix}_orbit_carrier_03" />
        <link name="${prefix}_gear_center_04" />

        <!-- 公转关节：link03 -> 公转载体 -->
        <joint name="${prefix}_joint_03_orbit_carrier" type="revolute">
            <parent link="${prefix}_03" />
            <child link="${prefix}_orbit_carrier_03" />
            <origin xyz="0 0 0" rpy="0 0 0" />
            <axis xyz="0 0 1" />
            <limit effort="${effort}" velocity="${velocity}" lower="${orbit_lower}" upper="${orbit_upper}" />
        </joint>

        <!-- 自转关节：公转载体 -> link04 齿轮中心 -->
        <!-- 公转半径 orbit_r；mimic 公转 1:1 实现自转 -->
        <joint name="${prefix}_joint_04_spin" type="continuous">
            <parent link="${prefix}_orbit_carrier_03" />
            <child link="${prefix}_gear_center_04" />
            <origin xyz="0 ${orbit_r} 0" rpy="0 0 0" />
            <axis xyz="0 0 1" />
            <limit effort="${effort}" velocity="${velocity}" />
            <mimic joint="${prefix}_joint_03_orbit_carrier" multiplier="1" offset="0" />
        </joint>

        <!-- 固定关节：link04 齿轮中心 -> link04 原点 -->
        <joint name="${prefix}_joint_04_mount" type="fixed">
            <parent link="${prefix}_gear_center_04" />
            <child link="${prefix}_04" />
            <origin xyz="0 ${origin_gear_center} 0" rpy="0 0 0" />
        </joint>

        <!-- **************************  link04 -> link05  ************************** -->
        <joint name="${prefix}_joint_04_05" type="revolute">
            <parent link="${prefix}_04" />
            <child link="${prefix}_05" />
            <origin xyz="0 ${y_offset_04_05} 0" rpy="0 0 0" />
            <axis xyz="1 0 0" />
            <limit effort="${effort}" velocity="${velocity}" lower="${-pi}" upper="${pi}" />
        </joint>

        <!-- link05 -> link06 -->
        <joint name="${prefix}_joint_05_06" type="fixed">
            <parent link="${prefix}_05" />
            <child link="${prefix}_06" />
            <origin xyz="0 ${y_offset_05_06} 0" rpy="0 0 0" />
        </joint>

        <!-- link06 -> link07 -->
        <joint name="${prefix}_joint_06_07" type="fixed">
            <parent link="${prefix}_06" />
            <child link="${prefix}_07" />
            <origin xyz="0 ${y_offset_06_07} 0" rpy="0 0 0" />
        </joint>

        <!-- link07 -> link08 -->
        <joint name="${prefix}_joint_07_08" type="revolute">
            <parent link="${prefix}_07" />
            <child link="${prefix}_08" />
            <origin xyz="0 ${y_offset_07_08} 0" rpy="0 0 0" />
            <axis xyz="1 0 0" />
            <limit effort="${effort}" velocity="${velocity}" lower="${-pi}" upper="${pi}" />
        </joint>

        <!-- link08 -> link09 -->
        <joint name="${prefix}_joint_08_09" type="revolute">
            <parent link="${prefix}_08" />
            <child link="${prefix}_09" />
            <origin xyz="0 ${y_offset_08_09} 0" rpy="0 0 0" />
            <axis xyz="0 0 1" />
            <limit effort="${effort}" velocity="${velocity}" lower="${-pi}" upper="${pi}" />
        </joint>

        <!-- link09 -> link10  -->
        <joint name="${prefix}_joint_09_10" type="fixed">
            <parent link="${prefix}_09" />
            <child link="${prefix}_10" />
            <origin xyz="0 ${y_offset_09_10} 0" rpy="0 0 0" />
        </joint>

        <!-- link10 -> link11  -->
        <joint name="${prefix}_joint_10_11" type="fixed">
            <parent link="${prefix}_10" />
            <child link="${prefix}_11" />
            <origin xyz="0 ${y_offset_10_11} 0" rpy="0 0 0" />
        </joint>

        <!-- link11 -> link12  -->
        <joint name="${prefix}_joint_11_12" type="revolute">
            <parent link="${prefix}_11" />
            <child link="${prefix}_12" />
            <origin xyz="0 ${y_offset_11_12} 0" rpy="0 0 0" />
            <axis xyz="0 0 1" />
            <limit effort="${effort}" velocity="${velocity}" lower="${-pi}" upper="${pi}" />
        </joint>

        <!-- link12 -> link13 -->
        <joint name="${prefix}_joint_12_13" type="revolute">
            <parent link="${prefix}_12" />
            <child link="${prefix}_13" />
            <origin xyz="0 ${y_offset_12_13} 0" rpy="0 0 0" />
            <axis xyz="1 0 0" />
            <limit effort="${effort}" velocity="${velocity}" lower="${-pi}" upper="${pi}" />
        </joint>

        <!-- link13 -> link14 -->
        <joint name="${prefix}_joint_13_14" type="revolute">
            <parent link="${prefix}_13" />
            <child link="${prefix}_14" />
            <origin xyz="0 ${y_offset_13_14} 0" rpy="0 0 0" />
            <axis xyz="0 0 1" />
            <limit effort="${effort}" velocity="${velocity}" lower="${-pi}" upper="${pi}" />
        </joint>

        <!-- link14 -> link15 -->
        <joint name="${prefix}_joint_14_15" type="revolute">
            <parent link="${prefix}_14" />
            <child link="${prefix}_15" />
            <origin xyz="0 ${y_offset_14_15} 0" rpy="0 0 0" />
            <axis xyz="1 0 0" />
            <limit effort="${effort}" velocity="${velocity}" lower="${-pi}" upper="${pi}" />
        </joint>

        <!-- link15 -> link16 -->
        <joint name="${prefix}_joint_15_16" type="fixed">
            <parent link="${prefix}_15" />
            <child link="${prefix}_16" />
            <origin xyz="0 ${y_offset_15_16} 0" rpy="0 0 0" />
        </joint>

        <!-- link16 -> link17 -->
        <joint name="${prefix}_joint_16_17" type="fixed">
            <parent link="${prefix}_16" />
            <child link="${prefix}_17" />
            <origin xyz="0 ${y_offset_16_17} 0" rpy="0 0 0" />
        </joint>

        <!-- link17 -> link18 -->
        <joint name="${prefix}_joint_17_18" type="revolute">
            <parent link="${prefix}_17" />
            <child link="${prefix}_18" />
            <origin xyz="0 ${y_offset_17_18} 0" rpy="0 0 0" />
            <axis xyz="0 1 0" />
            <limit effort="${effort}" velocity="${velocity}" lower="${-pi}" upper="${pi}" />
        </joint>

        <!-- link18 -> link19 -->
        <joint name="${prefix}_joint_18_19" type="fixed">
            <parent link="${prefix}_18" />
            <child link="${prefix}_19" />
            <origin xyz="0 ${y_offset_18_19} 0" rpy="0 0 0" />
        </joint>

        <!-- link19 -> link20 -->
        <joint name="${prefix}_joint_19_20" type="fixed">
            <parent link="${prefix}_19" />
            <child link="${prefix}_20" />
            <origin xyz="0 ${y_offset_19_20} 0" rpy="0 0 0" />
        </joint>

        <!-- link20 -> link21 （主动钳） -->
        <joint name="${prefix}_joint_20_21" type="revolute">
            <parent link="${prefix}_20" />
            <child link="${prefix}_21" />
            <origin xyz="0 ${y_offset_20_21} 0" rpy="0 0 0" />
            <axis xyz="0 0 1" />
            <limit effort="${effort}" velocity="${velocity}" lower="0" upper="${pi/3.0}" />
        </joint>

        <!-- link20 -> link22 （镜像钳） -->
        <joint name="${prefix}_joint_20_22" type="revolute">
            <parent link="${prefix}_20" />
            <child link="${prefix}_22" />
            <origin xyz="0 ${y_offset_20_22} 0" rpy="0 0 0" />
            <axis xyz="0 0 1" />
            <limit effort="${effort}" velocity="${velocity}" lower="${-pi/3.0}" upper="${0}" />
            <mimic joint="${prefix}_joint_20_21" multiplier="-1.0" offset="0.0" />
        </joint>


    </xacro:macro>

</robot>