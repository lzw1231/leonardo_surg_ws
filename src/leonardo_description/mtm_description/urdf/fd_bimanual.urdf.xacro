<?xml version="1.0" encoding='utf-8'?>
<robot name="fd_bimanual">

    <!-- ============================================================ -->
    <!-- Links                                                        -->
    <!-- ============================================================ -->
    <link name="fd_left_base"/>
    <link name="fd_left_x_link"/>
    <link name="fd_left_y_link"/>
    <link name="fd_left_z_link"/>
    <link name="fd_left_roll_link"/>
    <link name="fd_left_pitch_link"/>
    <link name="fd_left_yaw_link"/>
    <link name="fd_left_ee"/>

    <link name="fd_right_base"/>
    <link name="fd_right_x_link"/>
    <link name="fd_right_y_link"/>
    <link name="fd_right_z_link"/>
    <link name="fd_right_roll_link"/>
    <link name="fd_right_pitch_link"/>
    <link name="fd_right_yaw_link"/>
    <link name="fd_right_ee"/>

    <!-- ============================================================ -->
    <!-- 左右基座连接：右手 base 相对左手 base 沿 x 平移 0.5 m          -->
    <!-- ============================================================ -->
    <joint name="fd_left_to_right_base" type="fixed">
        <origin rpy="0 0 0" xyz="0.5 0 0"/>
        <parent link="fd_left_base"/>
        <child link="fd_right_base"/>
    </joint>

    <!-- ============================================================ -->
    <!-- 左侧运动链                                                    -->
    <!-- ============================================================ -->
    <joint name="fd_left_x" type="prismatic">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="fd_left_base"/>
        <child link="fd_left_x_link"/>
        <axis xyz="1 0 0"/>
        <limit effort="12" velocity="1.0" lower="-2" upper="2"/>
    </joint>
    <joint name="fd_left_y" type="prismatic">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="fd_left_x_link"/>
        <child link="fd_left_y_link"/>
        <axis xyz="0 1 0"/>
        <limit effort="12" velocity="1.0" lower="-2" upper="2"/>
    </joint>
    <joint name="fd_left_z" type="prismatic">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="fd_left_y_link"/>
        <child link="fd_left_z_link"/>
        <axis xyz="0 0 1"/>
        <limit effort="12" velocity="1.0" lower="-2" upper="2"/>
    </joint>
    <joint name="fd_left_roll" type="revolute">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="fd_left_z_link"/>
        <child link="fd_left_roll_link"/>
        <axis xyz="1 0 0"/>
        <limit effort="0.4" velocity="10.0" lower="-3.141592653589793" upper="3.141592653589793"/>
    </joint>
    <joint name="fd_left_pitch" type="revolute">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="fd_left_roll_link"/>
        <child link="fd_left_pitch_link"/>
        <axis xyz="0 1 0"/>
        <limit effort="0.4" velocity="10.0" lower="-3.141592653589793" upper="3.141592653589793"/>
    </joint>
    <joint name="fd_left_yaw" type="revolute">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="fd_left_pitch_link"/>
        <child link="fd_left_yaw_link"/>
        <axis xyz="0 0 1"/>
        <limit effort="0.4" velocity="10.0" lower="-3.141592653589793" upper="3.141592653589793"/>
    </joint>
    <joint name="fd_left_tool" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="fd_left_yaw_link"/>
        <child link="fd_left_ee"/>
    </joint>

    <!-- ============================================================ -->
    <!-- 右侧运动链                                                    -->
    <!-- ============================================================ -->
    <joint name="fd_right_x" type="prismatic">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="fd_right_base"/>
        <child link="fd_right_x_link"/>
        <axis xyz="1 0 0"/>
        <limit effort="12" velocity="1.0" lower="-2" upper="2"/>
    </joint>
    <joint name="fd_right_y" type="prismatic">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="fd_right_x_link"/>
        <child link="fd_right_y_link"/>
        <axis xyz="0 1 0"/>
        <limit effort="12" velocity="1.0" lower="-2" upper="2"/>
    </joint>
    <joint name="fd_right_z" type="prismatic">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="fd_right_y_link"/>
        <child link="fd_right_z_link"/>
        <axis xyz="0 0 1"/>
        <limit effort="12" velocity="1.0" lower="-2" upper="2"/>
    </joint>
    <joint name="fd_right_roll" type="revolute">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="fd_right_z_link"/>
        <child link="fd_right_roll_link"/>
        <axis xyz="1 0 0"/>
        <limit effort="0.4" velocity="10.0" lower="-3.141592653589793" upper="3.141592653589793"/>
    </joint>
    <joint name="fd_right_pitch" type="revolute">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="fd_right_roll_link"/>
        <child link="fd_right_pitch_link"/>
        <axis xyz="0 1 0"/>
        <limit effort="0.4" velocity="10.0" lower="-3.141592653589793" upper="3.141592653589793"/>
    </joint>
    <joint name="fd_right_yaw" type="revolute">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="fd_right_pitch_link"/>
        <child link="fd_right_yaw_link"/>
        <axis xyz="0 0 1"/>
        <limit effort="0.4" velocity="10.0" lower="-3.141592653589793" upper="3.141592653589793"/>
    </joint>
    <joint name="fd_right_tool" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="fd_right_yaw_link"/>
        <child link="fd_right_ee"/>
    </joint>

    <!-- ============================================================ -->
    <!-- ros2_control：左侧                                              -->
    <!-- ============================================================ -->
    <ros2_control name="FDLeftHardware" type="system">
        <hardware>
            <plugin>fd_left_hardware/FDLeftHardwareInterface</plugin>
            <param name="interface_id">-1</param>
            <param name="interface_sn">40619</param>
            <param name="emulate_button">true</param>
            <param name="inertia_interface_name">fd_left_inertia</param>
            <param name="effector_mass">0.5</param>
            <param name="ignore_orientation_readings">false</param>
        </hardware>

        <gpio name="fd_left_button">
            <state_interface name="position"/>
        </gpio>

        <joint name="fd_left_x">
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="fd_left_y">
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="fd_left_z">
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="fd_left_roll">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
            <command_interface name="effort"/>
        </joint>
        <joint name="fd_left_pitch">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
            <command_interface name="effort"/>
        </joint>
        <joint name="fd_left_yaw">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
            <command_interface name="effort"/>
        </joint>
    </ros2_control>

    <!-- ============================================================ -->
    <!-- ros2_control：右侧                                              -->
    <!-- ============================================================ -->
    <ros2_control name="FDRightHardware" type="system">
        <hardware>
            <plugin>fd_right_hardware/FDRightHardwareInterface</plugin>
            <param name="interface_id">-1</param>
            <param name="interface_serial_number">40819</param>
            <param name="emulate_button">true</param>
            <param name="inertia_interface_name">fd_right_inertia</param>
            <param name="effector_mass">-1.0</param>
            <param name="ignore_orientation_readings">false</param>
        </hardware>

        <gpio name="fd_right_button">
            <state_interface name="position"/>
        </gpio>

        <joint name="fd_right_x">
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="fd_right_y">
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="fd_right_z">
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="fd_right_roll">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
            <command_interface name="effort"/>
        </joint>
        <joint name="fd_right_pitch">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
            <command_interface name="effort"/>
        </joint>
        <joint name="fd_right_yaw">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
            <command_interface name="effort"/>
        </joint>
    </ros2_control>

</robot>