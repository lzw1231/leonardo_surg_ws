<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fd_left">
    <!-- Parameters -->
    <xacro:arg name="robot_id" default="fd_left"/> <!-- Name of the haptic interface -->
    <xacro:arg name="use_fake_hardware" default="false"/>
    <xacro:arg name="use_orientation" default="true"/>
    <xacro:arg name="use_gripper" default="true"/>

    <!-- Import interface urdf file -->
    <xacro:include filename="$(find raphael_description)/urdf/mtm/fd_left/fd_left.urdf.xacro"/>
    <xacro:haptic_interface
            robot_id="$(arg robot_id)"
            use_orientation="$(arg use_orientation)"
            use_gripper="$(arg use_gripper)"
    />

    <!-- Import and setup interface ros2_control description -->
    <xacro:include filename="$(find raphael_description)/urdf/mtm/fd_left/fd_left.r2c_hardware.xacro"/>
    <xacro:fd_left_ros2_control
            interface_id="-1"
            interface_sn="40619"
            robot_id="$(arg robot_id)"
            use_fake_hardware="$(arg use_fake_hardware)"
            use_orientation="$(arg use_orientation)"
            orientation_is_actuated="$(arg use_orientation)"
            ignore_orientation_readings="false"
            use_gripper="$(arg use_gripper)"
            emulate_button="true"
            effector_mass="0.5"
    />

    <!-- Default effector masses:
        - 0.148 kg for the Omega 3 device
        - 0.5 kg for the Omega 6 device
    -->
</robot>
