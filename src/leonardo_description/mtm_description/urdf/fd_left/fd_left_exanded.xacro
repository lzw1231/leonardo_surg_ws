<!-- |    This document was autogenerated by xacro from /home/lzw/Projects/raphael_surg_ws/install/raphael_description/share/raphael_description/urdf/mtm/fd_left/fd_left.config.xacro | -->
<!-- |    EDITING THIS FILE BY HAND IS NOT RECOMMENDED                                 | -->
