<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="leonardo">

    <!-- ==================== 引入 MTM 主手 ==================== -->
    <xacro:include
        filename="$(find leonardo_description)/mtm_description/urdf/fd_bimanual.config.xacro" />

    <!-- ==================== 引入 PSM 从手  ==================== -->
    <xacro:include filename="$(find leonardo_description)/psm_description/urdf/snakes.urdf.xacro" />

    <!-- ==================== 把 PSM 从手 挂到 MTM 双手 上 ==================== -->
    <joint name="MTM_PSM_base" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="fd_left_base" />
        <child link="snakes_footprint" />
    </joint>

</robot>