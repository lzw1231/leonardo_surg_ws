<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ============================================================
        各关节 y 轴偏移（单位：m）
         ============================================================ -->
    <xacro:property name="offset_y_01_02" value="0.0023" />
    <xacro:property name="offset_y_02_03" value="0.0046" />
    <xacro:property name="offset_y_03_04" value="0.0277" />
    <xacro:property name="offset_y_04_05" value="0.0046" />
    <xacro:property name="offset_y_05_06" value="0.00445" />
    <xacro:property name="offset_y_06_07" value="0.00575" />
    <xacro:property name="offset_y_07_08" value="0.0023" />


    <!-- ============================================================
         JOINT 定义
         ============================================================ -->

    <joint name="offset_joint_01_02" type="fixed">
        <parent link="ecm_01" />
        <child link="ecm_02" />
        <origin xyz="0 ${offset_y_01_02} 0" rpy="0 0 0" />
    </joint>

    <joint name="offset_joint_02_03" type="fixed">
        <parent link="ecm_02" />
        <child link="ecm_03" />
        <origin xyz="0 ${offset_y_02_03} 0" rpy="0 0 0" />
    </joint>

    <joint name="offset_joint_03_04" type="fixed">
        <parent link="ecm_03" />
        <child link="ecm_04" />
        <origin xyz="0 ${offset_y_03_04} 0" rpy="0 0 0" />
    </joint>

    <joint name="offset_joint_04_05" type="fixed">
        <parent link="ecm_04" />
        <child link="ecm_05" />
        <origin xyz="0 ${offset_y_04_05} 0" rpy="0 0 0" />
    </joint>

    <joint name="offset_joint_05_06" type="fixed">
        <parent link="ecm_05" />
        <child link="ecm_06" />
        <origin xyz="0 ${offset_y_05_06} 0" rpy="0 0 0" />
    </joint>

    <joint name="offset_joint_06_07" type="fixed">
        <parent link="ecm_06" />
        <child link="ecm_07" />
        <origin xyz="0 ${offset_y_06_07} 0" rpy="0 0 0" />
    </joint>

    <joint name="offset_joint_07_08" type="fixed">
        <parent link="ecm_07" />
        <child link="ecm_08" />
        <origin xyz="0 ${offset_y_07_08} 0" rpy="0 0 0" />
    </joint>

</robot>