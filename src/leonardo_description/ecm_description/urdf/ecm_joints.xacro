<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ============================================================
        各关节 y 轴偏移（单位：m）
         ============================================================ -->
    <xacro:property name="offset_y_01_02" value="0.0023" />
    <xacro:property name="offset_y_02_03" value="0.0046" />
    <xacro:property name="offset_y_03_04" value="0.01" />
    <xacro:property name="offset_y_04_05" value="0.0029" />
    <xacro:property name="offset_y_05_06" value="0.0225" />
    <xacro:property name="offset_y_06_07" value="0.00575" />
    <xacro:property name="offset_y_07_08" value="0.01" />
    <xacro:property name="offset_y_08_09" value="0.01" />
    <xacro:property name="offset_y_09_10" value="0.01" />

    <!-- ========= 最大力矩 ======== -->
    <xacro:property name="effort" value="1000" />

    <!-- ========= 最大速度 rad/s ======== -->
    <xacro:property name="velocity" value="${4.0 * pi}" />

    <!-- 蛇骨公转半径 -->
    <xacro:property name="orbit_r" value="0.0023" />

    <!-- 蛇骨公转角度限位（±22.5°） -->
    <xacro:property name="orbit_lower" value="${-pi/8.0}" />
    <xacro:property name="orbit_upper" value="${pi/8.0}" />

    <!-- 蛇骨自身原点相对自身齿轮中心的偏移 -->
    <xacro:property name="origin_gear_center_02_R" value="0.0" />
    <xacro:property name="origin_gear_center_03_L" value="0.0023" />
    <xacro:property name="origin_gear_center_03_R" value="0.0" />
    <xacro:property name="origin_gear_center_04_L" value="0.0" />
    <xacro:property name="origin_gear_center_06_R" value="0.0" />
    <xacro:property name="origin_gear_center_07_L" value="0.0023" />
    <xacro:property name="origin_gear_center_07_R" value="0.0" />
    <xacro:property name="origin_gear_center_08_L" value="0.00116" />
    <xacro:property name="origin_gear_center_08_R" value="0.00215" />
    <xacro:property name="origin_gear_center_09_L" value="0.0023" />
    <xacro:property name="origin_gear_center_09_R" value="0.0" />
    <xacro:property name="origin_gear_center_10_L" value="0.0" />

    <!-- ============================================================
         JOINT 定义
         ============================================================ -->

    <!-- link01 -> link02  -->
    <joint name="offset_joint_01_02" type="fixed">
        <parent link="ecm_01" />
        <child link="ecm_02" />
        <origin xyz="0 ${offset_y_01_02} 0" rpy="0 0 0" />
    </joint>

    <!-- link02 -> link03  -->
    <link name="ecm_orbit_carrier_02" />
    <link name="ecm_gear_center_03" />

    <joint name="ecm_j02_oc" type="revolute"> <!-- 公转关节 -->
        <parent link="ecm_02" />
        <child link="ecm_orbit_carrier_02" />
        <origin xyz="0 ${origin_gear_center_02_R} 0" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit effort="${effort}" velocity="${velocity}" lower="${orbit_lower}" upper="${orbit_upper}" />
    </joint>

    <joint name="ecm_joint_03_spin" type="continuous"> <!-- 自转关节 -->
        <parent link="ecm_orbit_carrier_02" />
        <child link="ecm_gear_center_03" />
        <origin xyz="0 ${orbit_r} 0 " rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit effort="${effort}" velocity="${velocity}" />
        <mimic joint="ecm_j02_oc" multiplier="1" offset="0" />
    </joint>

    <joint name="ecm_joint_03_mount" type="fixed"> <!-- 固连关节 -->
        <parent link="ecm_gear_center_03" />
        <child link="ecm_03" />
        <origin xyz="0 ${origin_gear_center_03_L} 0" rpy="0 0 0" />
    </joint>


    <!-- link03-> link04 -->
    <link name="ecm_orbit_carrier_03" />
    <link name="ecm_gear_center_04" />

    <joint name="ecm_j03_oc" type="revolute"> <!-- 公转关节 -->
        <parent link="ecm_03" />
        <child link="ecm_orbit_carrier_03" />
        <origin xyz="0 ${origin_gear_center_03_R} 0" rpy="0 0 0" />
        <axis xyz="1 0 0" />
        <limit effort="${effort}" velocity="${velocity}" lower="${orbit_lower}" upper="${orbit_upper}" />
    </joint>

    <joint name="ecm_joint_04_spin" type="continuous"> <!-- 自转关节 -->
        <parent link="ecm_orbit_carrier_03" />
        <child link="ecm_gear_center_04" />
        <origin xyz="0 ${orbit_r} 0 " rpy="0 0 0" />
        <axis xyz="1 0 0" />
        <limit effort="${effort}" velocity="${velocity}" />
        <mimic joint="ecm_j03_oc" multiplier="1" offset="0" />
    </joint>

    <joint name="ecm_joint_04_mount" type="fixed">  <!-- 固连关节 -->
        <parent link="ecm_gear_center_04" />
        <child link="ecm_04" />
        <origin xyz="0 ${origin_gear_center_04_L} 0" rpy="0 0 0" />
    </joint>

    <!-- link04-> link05 -->
    <joint name="offset_joint_04_05" type="fixed">
        <parent link="ecm_04" />
        <child link="ecm_05" />
        <origin xyz="0 ${offset_y_04_05} 0" rpy="0 0 0" />
    </joint>

    <!-- link05-> link06 -->
    <joint name="offset_joint_05_06" type="fixed">
        <parent link="ecm_05" />
        <child link="ecm_06" />
        <origin xyz="0 ${offset_y_05_06} 0" rpy="0 0 0" />
    </joint>

    <!-- link06-> link07 -->
    <link name="ecm_orbit_carrier_06" />
    <link name="ecm_gear_center_07" />

    <joint name="ecm_j06_oc" type="revolute"> <!-- 公转关节 -->
        <parent link="ecm_06" />
        <child link="ecm_orbit_carrier_06" />
        <origin xyz="0 ${origin_gear_center_06_R} 0" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit effort="${effort}" velocity="${velocity}" lower="${orbit_lower}" upper="${orbit_upper}" />
    </joint>

    <joint name="ecm_joint_07_spin" type="continuous"> <!-- 自转关节 -->
        <parent link="ecm_orbit_carrier_06" />
        <child link="ecm_gear_center_07" />
        <origin xyz="0 ${orbit_r} 0 " rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit effort="${effort}" velocity="${velocity}" />
        <mimic joint="ecm_j06_oc" multiplier="1" offset="0" />
    </joint>

    <joint name="ecm_joint_07_mount" type="fixed">  <!-- 固连关节 -->
        <parent link="ecm_gear_center_07" />
        <child link="ecm_07" />
        <origin xyz="0 ${origin_gear_center_07_L} 0" rpy="0 0 0" />
    </joint>


    <!-- link07-> link08 -->
    <link name="ecm_orbit_carrier_07" />
    <link name="ecm_gear_center_08" />

    <joint name="ecm_j07_oc" type="revolute"> <!-- 公转关节 -->
        <parent link="ecm_07" />
        <child link="ecm_orbit_carrier_07" />
        <origin xyz="0 ${origin_gear_center_07_R} 0" rpy="0 0 0" />
        <axis xyz="1 0 0" />
        <limit effort="${effort}" velocity="${velocity}" lower="${orbit_lower}" upper="${orbit_upper}" />
    </joint>

    <joint name="ecm_joint_08_spin" type="continuous"> <!-- 自转关节 -->
        <parent link="ecm_orbit_carrier_07" />
        <child link="ecm_gear_center_08" />
        <origin xyz="0 ${orbit_r} 0 " rpy="0 0 0" />
        <axis xyz="1 0 0" />
        <limit effort="${effort}" velocity="${velocity}" />
        <mimic joint="ecm_j07_oc" multiplier="1" offset="0" />
    </joint>

    <joint name="ecm_joint_08_mount" type="fixed">  <!-- 固连关节 -->
        <parent link="ecm_gear_center_08" />
        <child link="ecm_08" />
        <origin xyz="0 ${origin_gear_center_08_L} 0" rpy="0 0 0" />
    </joint>


    <!-- link08-> link09 -->
    <link name="ecm_orbit_carrier_08" />
    <link name="ecm_gear_center_09" />

    <joint name="ecm_j08_oc" type="revolute"> <!-- 公转关节 -->
        <parent link="ecm_08" />
        <child link="ecm_orbit_carrier_08" />
        <origin xyz="0 ${origin_gear_center_08_R} 0" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit effort="${effort}" velocity="${velocity}" lower="${orbit_lower}" upper="${orbit_upper}" />
    </joint>

    <joint name="ecm_joint_09_spin" type="continuous"> <!-- 自转关节 -->
        <parent link="ecm_orbit_carrier_08" />
        <child link="ecm_gear_center_09" />
        <origin xyz="0 ${orbit_r} 0 " rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit effort="${effort}" velocity="${velocity}" />
        <mimic joint="ecm_j08_oc" multiplier="1" offset="0" />
    </joint>

    <joint name="ecm_joint_09_mount" type="fixed">  <!-- 固连关节 -->
        <parent link="ecm_gear_center_09" />
        <child link="ecm_09" />
        <origin xyz="0 ${origin_gear_center_09_L} 0" rpy="0 0 0" />
    </joint>


    <!-- link09-> link10 -->
    <link name="ecm_orbit_carrier_09" />
    <link name="ecm_gear_center_10" />

    <joint name="ecm_j09_oc" type="revolute"> <!-- 公转关节 -->
        <parent link="ecm_09" />
        <child link="ecm_orbit_carrier_09" />
        <origin xyz="0 ${origin_gear_center_09_R} 0" rpy="0 0 0" />
        <axis xyz="1 0 0" />
        <limit effort="${effort}" velocity="${velocity}" lower="${orbit_lower}" upper="${orbit_upper}" />
    </joint>

    <joint name="ecm_joint_10_spin" type="continuous"> <!-- 自转关节 -->
        <parent link="ecm_orbit_carrier_09" />
        <child link="ecm_gear_center_10" />
        <origin xyz="0 ${orbit_r} 0 " rpy="0 0 0" />
        <axis xyz="1 0 0" />
        <limit effort="${effort}" velocity="${velocity}" />
        <mimic joint="ecm_j09_oc" multiplier="1" offset="0" />
    </joint>

    <joint name="ecm_joint_10_mount" type="fixed">  <!-- 固连关节 -->
        <parent link="ecm_gear_center_10" />
        <child link="ecm_10" />
        <origin xyz="0 ${origin_gear_center_10_L} 0" rpy="0 0 0" />
    </joint>


</robot>