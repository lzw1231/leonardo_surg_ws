<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ============ 全局参数 米制=1 1 1，毫米制=0.001 0.001 0.001 ============ -->
    <xacro:property name="mesh_scale" value="0.001 0.001 0.001" />

    <!-- ============ 引入材质库 ============ -->
    <xacro:include filename="$(find ecm_description)/materials/ecm_materials.xacro" />

    <!-- ============================================================
       LINK: ecm_base
       ============================================================ -->
    <link name="ecm_base">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://ecm_description/meshes/stl/ecm_base.stl" scale="${mesh_scale}" />
            </geometry>
            <material name="ecm_material_base" />
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://ecm_description/meshes/stl/ecm_base.stl" scale="${mesh_scale}" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.1" />
            <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3" />
        </inertial>
    </link>

    <!-- ============================================================
       LINK: ecm_02
       ============================================================ -->
    <link name="ecm_02">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
