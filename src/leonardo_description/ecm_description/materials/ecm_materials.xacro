    <material name="ecm_material_02">
        <color rgba="0.48 0.44 0.36 ${alpha}" />
    </material>
    <material name="ecm_material_03">
        <color rgba="0.56 0.52 0.42 ${alpha}" />
    </material>
    <material name="ecm_material_04">
        <color rgba="0.64 0.60 0.48 ${alpha}" />
    </material>
    <material name="ecm_material_05">
        <color rgba="0.72 0.68 0.54 ${alpha}" />
    </material>
    <material name="ecm_material_06">
        <color rgba="0.80 0.76 0.60 ${alpha}" />
    </material>
    <material name="ecm_material_07">
        <color rgba="0.88 0.84 0.68 ${alpha}" />
    </material>
    <material name="ecm_material_08">
        <color rgba="0.94 0.90 0.76 ${alpha}" />
    </material>


</robot>