{
    // [ROS 2]
    "ROS2.distro": "lyrical",
    "terminal.integrated.env.linux": {
        "RCUTILS_COLORIZED_OUTPUT": "1",
        "RCUTILS_CONSOLE_OUTPUT_FORMAT": "[{severity}] {message}"
    },
    // [C++ / clangd]
    "clangd.path": "/usr/bin/clangd-23",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}",
        "--background-index",
        "--clang-tidy",
        "--header-insertion=iwyu",
        "--completion-style=detailed",
        "--query-driver=/opt/LLVM-23/bin/clang++",
        "--fallback-style=LLVM",
        "-j=4"
    ],
    "C_Cpp.intelliSenseEngine": "disabled",
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    // [Python]
    "python.autoComplete.extraPaths": [
        "/opt/ros/lyrical/opt/gz_math_vendor/lib/python",
        "/opt/ros/lyrical/lib/python3.14/site-packages"
    ],
    "python.analysis.extraPaths": [
        "/opt/ros/lyrical/opt/gz_math_vendor/lib/python",
        "/opt/ros/lyrical/lib/python3.14/site-packages"
    ],
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true
    },
    // [Ruff]
    "ruff.path": [
        "/usr/local/bin/ruff"
    ],
    "ruff.lineLength": 120,
    // [Files]
    "files.associations": {
        "*.xacro": "xml",
        "*.urdf": "xml",
        "*.sdf": "xml",
        "*.launch.py": "python"
    },
    "search.exclude": {
        "**/build": true,
        "**/install": true,
        "**/log": true
    },
    "files.watcherExclude": {
        "**/build/**": true,
        "**/install/**": true,
        "**/log/**": true
    },
    //是否在插入目录树后自动打开README文件默认为true
    "directoryTree.openREADME": true,
    //是否忽略.git目录，默认为true
    "directoryTree.ignoreGit": true,
    //是否在目录中添加文件夹和文件的Emoji，默认为false
    "directoryTree.supportEmoji": false,
    //支持两种主题，Linux-Tree和Markdown-List-Nesting，Linux-Tree是类似于linux下tree命令生成的树形结构，Markdown-List-Nesting是markdown的列表嵌套格式，默认是Linux-Tree
    "directoryTree.theme": "Linux-Tree"
}