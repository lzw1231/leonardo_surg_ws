{
    // [ROS 2]
    "ROS2.distro": "lyrical",
    "terminal.integrated.env.linux": {
        "RCUTILS_COLORIZED_OUTPUT": "1",
        "RCUTILS_CONSOLE_OUTPUT_FORMAT": "[{severity}] {message}"
    },
    // [C++ / clangd]
    "clangd.path": "/opt/LLVM-23/bin/clangd",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}",
        "--background-index",
        "--clang-tidy",
        "--header-insertion=iwyu",
        "--completion-style=detailed",
        "--query-driver=/opt/LLVM-23/bin/clang++",
        "--fallback-style=LLVM",
        "-j=4"
    ],
    "C_Cpp.intelliSenseEngine": "disabled",
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    // [Debugger]
    "lldb.library": "/opt/LLVM-23/lib/liblldb.so",
    // [Python]
    "python.autoComplete.extraPaths": [
        "/opt/ros/lyrical/opt/gz_math_vendor/lib/python",
        "/opt/ros/lyrical/lib/python3.14/site-packages"
    ],
    "python.analysis.extraPaths": [
        "/opt/ros/lyrical/opt/gz_math_vendor/lib/python",
        "/opt/ros/lyrical/lib/python3.14/site-packages"
    ],
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true
    },
    // [Ruff]
    "ruff.path": [
        "/usr/local/bin/ruff"
    ],
    "ruff.lineLength": 120,
    // [Files]
    "files.associations": {
        "*.xacro": "xml",
        "*.urdf": "xml",
        "*.sdf": "xml",
        "*.launch.py": "python"
    },
    "search.exclude": {
        "**/build": true,
        "**/install": true,
        "**/log": true
    },
    "files.watcherExclude": {
        "**/build/**": true,
        "**/install/**": true,
        "**/log/**": true
    }
}