{
    // ============================================================
    // ROS 2
    // ============================================================
    "ROS2.distro": "lyrical",
    "terminal.integrated.env.linux": {
        "RCUTILS_COLORIZED_OUTPUT": "1",
        "RCUTILS_CONSOLE_OUTPUT_FORMAT": "[{severity}] {message}"
    },
    // ============================================================
    // Python
    // ============================================================
    "python.autoComplete.extraPaths": [
        "/opt/ros/lyrical/opt/gz_math_vendor/lib/python",
        "/opt/ros/lyrical/lib/python3.14/site-packages"
    ],
    "python.analysis.extraPaths": [
        "/opt/ros/lyrical/opt/gz_math_vendor/lib/python",
        "/opt/ros/lyrical/lib/python3.14/site-packages"
    ],
    "ruff.path": [
        "/home/lzw/.local/bin/ruff"
    ],
    "ruff.lineLength": 120,
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true
    },
    // ============================================================
    // C/C++（clangd + cpptools）
    // ============================================================
    "clangd.path": "/opt/LLVM-23/bin/clangd",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build",
        "--background-index",
        "--clang-tidy",
        "--header-insertion=iwyu",
        "--completion-style=detailed",
        "--query-driver=/opt/LLVM-23/bin/clang++",
        "--fallback-style=LLVM",
        "-j=4"
    ],
    "C_Cpp.intelliSenseEngine": "disabled",
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    }
}