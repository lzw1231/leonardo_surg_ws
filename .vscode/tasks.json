{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "colcon: Incremental Build",
            "type": "shell",
            "command": "./colcon_build.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "colcon: Clean Build",
            "type": "shell",
            "command": "./colcon_build.sh --clean",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            },
            "problemMatcher": []
        }
    ]
}